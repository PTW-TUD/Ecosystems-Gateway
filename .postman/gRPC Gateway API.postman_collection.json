									"headerFamily": "json",
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/grpc/GetComputeToDataStatus",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"grpc",
								"GetComputeToDataStatus"
							]
						},
						"description": "Calls the gRPC method GetComputeToDataStatus"
					},
					"response": []
				},
				{
					"name": "Get Status with Details",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"jobId\": \"<environmentHash>-<jobId>\",\n    \"details\": true\n}\n",
							"options": {
								"raw": {
									"headerFamily": "json",
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/grpc/GetComputeToDataStatus",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"grpc",
								"GetComputeToDataStatus"
							]
						},
						"description": "Returns the job as the node reports it: phase timestamps, environment, resources, payment transactions, result files with their index, exit code and runtime metrics. Needs EXTENDED_RESPONSES=true on the gateway."
					},
					"response": []
				}
			],
			"description": "The Compute-to-Data v2 status of a job, e.g. 1 queued, 40 running algorithm, 70 finished; a job that ends below 70 failed."
		},
