		{
			"name": "RunComputeToDataJob",
			"item": [
				{
					"name": "Request a Compute2Data Job",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"did\": \"did:ope:<dataset>\",\n    \"algorithm\": \"did:ope:<algorithm>\",\n    \"algorithmParameters\": {},\n    \"computeEnv\": \"<environment id from GetComputeEnvironments>\",\n    \"resources\": [\n        {\n            \"id\": \"cpu\",\n            \"amount\": 1\n        }\n    ]\n}\n",
							"options": {
								"raw": {
									"headerFamily": "json",
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/grpc/RunComputeToDataJob",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"grpc",
								"RunComputeToDataJob"
							]
						},
						"description": "Calls the gRPC method RunComputeToDataJob"
					},
					"response": []
				},
				{
					"name": "Request a Compute2Data Job on several datasets",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"did\": \"did:ope:<model artifact 1>\",\n    \"algorithm\": \"did:ope:<aggregation algorithm>\",\n    \"additionalDatasets\": [\n        {\n            \"did\": \"did:ope:<model artifact 2>\"\n        },\n        {\n            \"did\": \"did:ope:<model artifact 3>\",\n            \"userdata\": {}\n        }\n    ],\n    \"algorithmEnvs\": {\n        \"OMP_NUM_THREADS\": \"2\"\n    },\n    \"free\": true\n}\n",
							"options": {
								"raw": {
									"headerFamily": "json",
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/grpc/RunComputeToDataJob",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"grpc",
								"RunComputeToDataJob"
							]
						},
						"description": "Runs one algorithm on several datasets (additionalDatasets), with environment variables in its container (algorithmEnvs). With EXTENDED_RESPONSES=true the response also carries the order transactions, escrow payment, provider fees and submit and start times."
					},
					"response": []
				}
			],
			"description": "Starts a compute-to-data job: an algorithm runs on one or more datasets in a compute environment of the ocean-node, and only its results leave it.\n\nSee CreateComputeToDataRequest in src/_proto/spp_v3.proto for all fields. The response holds the ocean-node job id (`<environmentHash>-<jobId>`), which the status and result calls take."
		},
		{
			"name": "GetComputeToDataStatus",
			"item": [
				{
					"name": "Get Status",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
