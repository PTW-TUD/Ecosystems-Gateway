					"response": []
				},
				{
					"name": "Get Result as URL",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"jobId\": \"<environmentHash>-<jobId>\",\n    \"computeToDataReturnType\": \"C2D_URI\"\n}\n",
							"options": {
								"raw": {
									"headerFamily": "json",
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/grpc/GetComputeToDataResult",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"grpc",
								"GetComputeToDataResult"
							]
						},
						"description": "A download URL of the ocean-node for the output archive."
					},
					"response": []
				},
				{
					"name": "Get Algorithm Log as URL",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"jobId\": \"<environmentHash>-<jobId>\",\n    \"computeToDataReturnType\": \"C2D_URI\",\n    \"jobIndex\": 0\n}\n",
							"options": {
								"raw": {
									"headerFamily": "json",
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/grpc/GetComputeToDataResult",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"grpc",
								"GetComputeToDataResult"
							]
						},
						"description": "A download URL of one result file: jobIndex is the index of the file in the results of GetComputeToDataStatus with details, e.g. the one of type algorithmLog."
					},
					"response": []
				}
			],
			"description": "The result of a finished compute-to-data job: the output archive as data (C2D_DATA) or a download URL (C2D_URI); with C2D_URI, jobIndex selects another result file."
		},
