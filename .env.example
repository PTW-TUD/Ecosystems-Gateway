# General
ENABLE_GRPC_SERVER=true
GRPC_BIND="0.0.0.0:5002"
ENABLE_GRPC_REFLECTION=false

ENABLE_GRPC_GATEWAY=false
GRPC_GATEWAY_BIND="0.0.0.0:3000"

REDIS_ADDRESS="127.0.0.1:6379"
# verbose, debug, log, warn, error, fatal (error and fatal are always logged)
NESTJS_LOG_LEVELS=log,warn,debug
# text or json
LOG_FORMAT=text

# One of silent, error, warn, info, debug, trace. Defaults to the most verbose NESTJS_LOG_LEVELS.
# NAUTILUS_LOG_LEVEL=debug
# Raw data nautilus otherwise redacts, on stderr: sensitive or secrets. Never in production.
# NAUTILUS_DEBUG=sensitive
# NAUTILUS_DEBUG_TOPICS=policy,wallet

# Optional
CES_URL="https://ces-development.lab.gaia-x.eu/credentials-events"

# Pontus-X config
# OPSEPOLIA (OP Sepolia, the default), PONTUSXDEV or PONTUSXTEST
NETWORK="OPSEPOLIA"
# Needs OP Sepolia ETH for gas, and devEURAU for paid assets and compute.
PRIVATE_KEY="xxx"
# The ocean-node (OceanProtocolEnterprise ocean-node 4.2.x) to use. Defaults to
# https://node.demo.pontus-x.eu on OPSEPOLIA; required on PONTUSXDEV and PONTUSXTEST, which
# no public ocean-node serves yet.
# OCEAN_NODE_URI="https://node.demo.pontus-x.eu"
# Optional chain RPC override (default https://sepolia.optimism.io), and a second RPC of the
# same chain for safe resends.
# RPC_URL="https://sepolia.optimism.io"
# VERIFICATION_RPC_URL="https://another-rpc.example.org"
# Optional organisation providing the assets (DDO v5 providedBy). Defaults to the author.
# PROVIDED_BY="PTW TU Darmstadt"

# Where the node-encrypted DDO is stored: ipfs or s3. Needed to create and update offerings.
DDO_STORE="ipfs"
IPFS_UPLOAD_URL="https://api.pinata.cloud/pinning/pinFileToIPFS"
IPFS_JWT="xxx"
# The gateway the DDO is read back from; needed for anything but Kubo.
IPFS_GATEWAY_URL="https://gateway.pinata.cloud"
# IPFS_VERIFY=false
# DDO_STORE="s3"
# S3_ENDPOINT="https://sos-de-fra-1.exo.io"
# S3_NODE_ENDPOINT=""
# S3_REGION="de-fra-1"
# S3_BUCKET=""
# S3_PREFIX="ddo/"
# S3_FORCE_PATH_STYLE=false
# S3_WRITE_ACCESS_KEY_ID=""
# S3_WRITE_SECRET_ACCESS_KEY=""
# The read key is written, node-encrypted, into every on-chain pointer: read-only, scoped to S3_PREFIX.
# S3_READ_ACCESS_KEY_ID=""
# S3_READ_SECRET_ACCESS_KEY=""

# What a node may charge, "<token address>:<amount in the token's smallest unit>", comma separated.
# Unset: only zero provider fees are paid, and compute jobs needing escrow are refused.
# On OP Sepolia the demo node charges in devEURAU (6 decimals: 1000000 is 1 devEURAU).
# MAX_PROVIDER_FEE="0xD35141583f374d401fee1BFdDc35910E1D33a588:1000000"
# MAX_ESCROW_PAYMENT="0xD35141583f374d401fee1BFdDc35910E1D33a588:5000000"
# The chain's EnterpriseEscrow contract, the only one paid compute funds. Unset, nautilus uses
# the one in Ocean's address data (on OP Sepolia the demo node's); needed for paid compute on
# Pontus-X, for which the address data has none.
# ESCROW_ADDRESS="0x..."
# The compute environment to use. Defaults to the ocean-node's first.
# COMPUTE_ENV=""

# XFSC Config
# We use OAuth2.0 password flow. You need to configure client/secret and username/password.
XFSC_USERNAME=jan
XFSC_PASSWORD=xxxx
CLIENT_SECRET=xxxxxxxxxx
CLIENT_ID=federated-catalog
XFSC_CAT_HOST_SD_ENDPOINT="https://fc-server.gxfs-dev.euprogigant.io/"
XFSC_CAT_TOKEN_ENDPOINT="https://key-server.gxfs-dev.euprogigant.io/realms/gaia-x/protocol/openid-connect/token"
